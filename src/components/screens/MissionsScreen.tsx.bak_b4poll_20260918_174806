import { useState, useEffect, useCallback } from 'react';
import { API_BASE } from '../../hooks/useApi';
import { SkeletonList } from '../ui/Skeleton';
import { RetryButton } from '../ui/RetryButton';

interface Mission {
  id: string;
  title: string;
  status: string;
  progress: number;
  isCritical: boolean;
  createdAt: string;
}

interface Approval {
  approval_id: string;
  task_id: string;
  capability_name: string;
  safe_summary: string;
  status: string;
}

function statusColor(s: string): string {
  const up = s.toUpperCase();
  if (['RUNNING', 'ACTIVE', 'EXECUTING', 'WORKING'].includes(up)) return 'var(--status-running)';
  if (['PENDING', 'PENDING_APPROVAL'].includes(up)) return 'var(--status-pending)';
  if (['COMPLETED', 'DONE', 'SUCCESS'].includes(up)) return 'var(--status-success)';
  if (['FAILED', 'ERROR', 'CANCELLED'].includes(up)) return 'var(--status-error)';
  if (['PAUSED'].includes(up)) return 'var(--status-warning)';
  return 'var(--text-muted)';
}

export function MissionsScreen() {
  const [missions, setMissions] = useState<Mission[]>([]);
  const [approvals, setApprovals] = useState<Approval[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [lastUpdate, setLastUpdate] = useState<Date | null>(null);

  const load = useCallback(async () => {
    try {
      const [mRes, aRes] = await Promise.all([
        fetch(`${API_BASE}/master/missions`).then(r => r.json()),
        fetch(`${API_BASE}/master/approvals/pending`).then(r => r.json()),
      ]);
      const mList = (mRes.missions || []).map((m: Record<string, unknown>) => ({
        id: (m.id as string) || (m.mission_id as string) || 'unknown',
        title: (m.title as string) || (m.name as string) || (m.id as string) || 'Sans titre',
        status: (m.status as string) || 'pending',
        progress: typeof m.progress === 'number' ? m.progress : 0,
        isCritical: !!m.isCritical || ['HIGH', 'CRITICAL'].includes(((m.risk_level as string) || '').toUpperCase()),
        createdAt: (m.createdAt as string) || (m.created_at as string) || new Date().toISOString(),
      }));
      setMissions(mList);
      setApprovals(aRes.pending_approvals || []);
      setLastUpdate(new Date());
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Erreur réseau');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void load();
    const id = window.setInterval(load, 10000);
    return () => window.clearInterval(id);
  }, [load]);

  const decide = async (approvalId: string, decision: 'APPROVE' | 'REJECT') => {
    try {
      await fetch(`${API_BASE}/master/approvals/${approvalId}/decide`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision, decided_by: 'desktop_user' }),
      });
      void load();
    } catch (e) { console.error(e); }
  };

  return (
    <div style={{ padding: 24, maxWidth: 1100, margin: '0 auto' }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
        <div>
          <h2 style={{ fontSize: 20, fontWeight: 700, color: 'var(--text-primary)' }}>Missions</h2>
          {lastUpdate && (
            <div style={{ fontSize: 11, color: 'var(--text-muted)', marginTop: 4 }}>
              Dernière mise à jour : {lastUpdate.toLocaleTimeString('fr-FR')}
            </div>
          )}
        </div>
        <button onClick={load} disabled={loading} className="btn-secondary">
          {loading ? '↻ …' : '↻ Actualiser'}
        </button>
      </div>

      {error && <RetryButton onRetry={load} message={error} />}

      {loading && missions.length === 0 && !error && (
        <SkeletonList rows={5} rowHeight={70} />
      )}

      {approvals.length > 0 && (
        <div style={{ marginBottom: 24 }}>
          <h3 style={{
            fontSize: 12, fontWeight: 700, textTransform: 'uppercase',
            letterSpacing: 0.5, color: 'var(--status-pending)',
            fontFamily: 'var(--font-mono)', marginBottom: 12,
          }}>
            Approbations en attente ({approvals.length})
          </h3>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            {approvals.map(a => (
              <div key={a.approval_id} style={{
                padding: 14, background: 'var(--bg-card)', borderRadius: 8,
                border: '1px solid color-mix(in srgb, var(--status-pending) 30%, transparent)',
              }}>
                <div style={{ fontWeight: 600, fontSize: 13, color: 'var(--text-primary)', marginBottom: 4 }}>
                  {a.capability_name}
                </div>
                <div style={{ fontSize: 12, color: 'var(--text-secondary)', marginBottom: 10 }}>
                  {a.safe_summary}
                </div>
                <div style={{ display: 'flex', gap: 8 }}>
                  <button onClick={() => decide(a.approval_id, 'APPROVE')} className="btn-primary" style={{ padding: '6px 14px', fontSize: 12 }}>Approuver</button>
                  <button onClick={() => decide(a.approval_id, 'REJECT')} className="btn-secondary" style={{ padding: '6px 14px', fontSize: 12 }}>Rejeter</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {missions.length > 0 && (
        <>
          <h3 style={{
            fontSize: 12, fontWeight: 700, textTransform: 'uppercase',
            letterSpacing: 0.5, color: 'var(--text-muted)',
            fontFamily: 'var(--font-mono)', marginBottom: 12,
          }}>
            Toutes les missions ({missions.length})
          </h3>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            {missions.map(m => (
              <div key={m.id} style={{
                padding: 14, background: 'var(--bg-card)', borderRadius: 8,
                border: '1px solid var(--border-subtle)',
              }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    {m.isCritical && <span style={{ fontSize: 10, color: 'var(--status-error)', fontFamily: 'var(--font-mono)' }}>CRITIQUE</span>}
                    <span style={{ fontWeight: 600, fontSize: 14, color: 'var(--text-primary)' }}>{m.title}</span>
                  </div>
                  <span style={{ fontSize: 12, color: statusColor(m.status), fontFamily: 'var(--font-mono)' }}>
                    ● {m.status}
                  </span>
                </div>
                <div style={{ height: 6, background: 'var(--bg-secondary)', borderRadius: 3, overflow: 'hidden' }}>
                  <div style={{ width: `${m.progress}%`, height: '100%', background: statusColor(m.status), transition: 'width 0.3s' }} />
                </div>
                <div style={{ fontSize: 10, color: 'var(--text-muted)', marginTop: 4, fontFamily: 'var(--font-mono)' }}>
                  {m.progress}% · {new Date(m.createdAt).toLocaleString('fr-FR')}
                </div>
              </div>
            ))}
          </div>
        </>
      )}

      {!loading && missions.length === 0 && !error && (
        <div style={{ textAlign: 'center', padding: 40, opacity: 0.5 }}>Aucune mission</div>
      )}
    </div>
  );
}