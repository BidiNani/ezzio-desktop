import { useState, useEffect } from 'react';

const API = 'http://127.0.0.1:8001';

interface MemoryItem {
  id?: string;
  content?: string;
  text?: string;
  role?: string;
  timestamp?: string;
  session_id?: string;
  metadata?: Record<string, unknown>;
}

interface MemoryResponse {
  items: MemoryItem[];
}

export function MemoryScreen() {
  const [items, setItems] = useState<MemoryItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState('');
  const [searching, setSearching] = useState(false);
  const [selected, setSelected] = useState<MemoryItem | null>(null);

  const load = async (q?: string) => {
    setLoading(true);
    setError(null);
    try {
      if (q && q.trim()) {
        const r = await fetch(`${API}/memory/search`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, limit: 20 }),
        });
        const d = await r.json();
        setItems(d.items || d.results || []);
      } else {
        const r = await fetch(`${API}/memory/recent?limit=30`);
        const d: MemoryResponse = await r.json();
        setItems(d.items || []);
      }
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Erreur réseau');
    } finally {
      setLoading(false);
      setSearching(false);
    }
  };

  useEffect(() => { void load(); }, []);

  const onSearch = () => {
    setSearching(true);
    void load(search);
  };

  const clearSearch = () => {
    setSearch('');
    void load();
  };

  return (
    <div style={{ display: 'flex', height: '100%' }}>
      <div style={{ flex: 1, padding: 24, overflow: 'auto' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 16 }}>
          <h2 style={{ fontSize: 20, fontWeight: 700, color: 'var(--text-primary)' }}>
            Mémoire ({items.length})
          </h2>
        </div>

        {/* Barre de recherche */}
        <div style={{ display: 'flex', gap: 8, marginBottom: 16 }}>
          <input
            type="text"
            placeholder="Rechercher dans la mémoire…"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && onSearch()}
            className="input-field"
            style={{ flex: 1 }}
          />
          <button onClick={onSearch} disabled={searching} className="btn-primary">
            {searching ? 'Recherche…' : 'Rechercher'}
          </button>
          {search && (
            <button onClick={clearSearch} className="btn-secondary">×</button>
          )}
        </div>

        {error && (
          <div style={{ padding: 12, marginBottom: 12, borderRadius: 6, background: 'color-mix(in srgb, var(--status-error) 12%, transparent)', color: 'var(--status-error)', fontSize: 13 }}>
            {error}
          </div>
        )}

        {loading && <div style={{ opacity: 0.6 }}>Chargement…</div>}

        <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
          {items.map((m, i) => (
            <button
              key={m.id || i}
              onClick={() => setSelected(m)}
              style={{
                display: 'flex', justifyContent: 'space-between',
                padding: '10px 12px', background: 'var(--bg-card)',
                border: '1px solid var(--border-subtle)', borderRadius: 4,
                cursor: 'pointer', textAlign: 'left', color: 'var(--text-primary)', fontSize: 12,
              }}
            >
              <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                {m.role && (
                  <span style={{ marginRight: 8, color: m.role === 'user' ? 'var(--accent-blue)' : 'var(--status-running)', fontFamily: 'var(--font-mono)', fontSize: 10 }}>
                    {m.role}
                  </span>
                )}
                {m.text || m.content || '(vide)'}
              </span>
              <span style={{ fontSize: 10, opacity: 0.5, marginLeft: 8, flexShrink: 0 }}>
                {m.timestamp ? new Date(m.timestamp).toLocaleTimeString('fr-FR') : ''}
              </span>
            </button>
          ))}
          {!loading && items.length === 0 && (
            <div style={{ textAlign: 'center', padding: 40, opacity: 0.5 }}>
              {search ? 'Aucun résultat' : 'Mémoire vide'}
            </div>
          )}
        </div>
      </div>

      {/* Détail */}
      {selected && (
        <div style={{ width: '45%', padding: 24, borderLeft: '1px solid var(--border-subtle)', overflow: 'auto', background: 'var(--bg-card)' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 12 }}>
            <span style={{ fontSize: 11, fontFamily: 'var(--font-mono)', color: 'var(--text-muted)' }}>
              {selected.id || '(pas d\'id)'}
            </span>
            <button onClick={() => setSelected(null)} className="btn-secondary">×</button>
          </div>
          <pre style={{ fontSize: 11, lineHeight: 1.5, whiteSpace: 'pre-wrap', wordBreak: 'break-word', color: 'var(--text-primary)' }}>
            {JSON.stringify(selected, null, 2)}
          </pre>
        </div>
      )}
    </div>
  );
}