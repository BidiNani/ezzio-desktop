import { useState, useEffect, useCallback } from 'react';

const API = 'http://127.0.0.1:8001';

interface ProviderHealth {
  online?: boolean;
  latency_ms?: number;
  configured?: boolean;
  error?: string | null;
  status?: string;
}

interface ProvidersResponse {
  ok: boolean;
  health: {
    timestamp: number;
    providers: Record<string, ProviderHealth>;
    primary_available: boolean;
    deterministic_support: Record<string, string>;
  };
}

interface Diagnostics {
  ok?: boolean;
  audit_ledger?: { status?: string };
  [key: string]: unknown;
}

function Bar({ value, max, color }: { value: number; max: number; color: string }) {
  const pct = Math.min(100, (value / max) * 100);
  return (
    <div style={{
      height: 8, background: 'var(--bg-secondary)',
      borderRadius: 4, overflow: 'hidden', marginTop: 4,
    }}>
      <div style={{
        width: `${pct}%`, height: '100%', background: color,
        transition: 'width 0.3s',
      }} />
    </div>
  );
}

function statusColor(s: string): string {
  if (s === 'online' || s === 'configured' || s === 'SECURE') return 'var(--status-running)';
  if (s === 'degraded') return 'var(--status-warning)';
  if (s === 'offline') return 'var(--status-error)';
  return 'var(--text-muted)';
}

export function HealthScreen() {
  const [providers, setProviders] = useState<ProvidersResponse['health'] | null>(null);
  const [diagnostics, setDiagnostics] = useState<Diagnostics | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [lastUpdate, setLastUpdate] = useState<Date | null>(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const [pRes, dRes] = await Promise.all([
        fetch(`${API}/master/providers/health`).then(r => r.json()),
        fetch(`${API}/master/system/diagnostics`).then(r => r.json()).catch(() => null),
      ]);
      if (pRes.ok) setProviders(pRes.health);
      setDiagnostics(dRes);
      setLastUpdate(new Date());
    } catch (e) {
      setError(e instanceof Error ? e.message : 'Erreur réseau');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void load();
    const id = window.setInterval(load, 15000);
    return () => window.clearInterval(id);
  }, [load]);

  if (loading && !providers) {
    return <div style={{ padding: 24, opacity: 0.6 }}>Chargement…</div>;
  }
  if (error && !providers) {
    return <div style={{ padding: 24, color: 'var(--status-error)' }}>Erreur : {error}</div>;
  }
  if (!providers) return null;

  const providerList = Object.entries(providers.providers);

  return (
    <div style={{ padding: 24, maxWidth: 1000, margin: '0 auto' }}>
      {/* Header */}
      <div style={{
        display: 'flex', justifyContent: 'space-between',
        alignItems: 'center', marginBottom: 16,
      }}>
        <div>
          <h2 style={{ fontSize: 20, fontWeight: 700, color: 'var(--text-primary)' }}>
            Santé système
          </h2>
          {lastUpdate && (
            <div style={{ fontSize: 11, color: 'var(--text-muted)', marginTop: 4 }}>
              Dernière mise à jour : {lastUpdate.toLocaleTimeString('fr-FR')}
            </div>
          )}
        </div>
        <button onClick={load} disabled={loading} className="btn-secondary">
          {loading ? '↻ …' : '↻ Actualiser'}
        </button>
      </div>

      {/* Bandeau état global */}
      <div style={{
        padding: 16, marginBottom: 16, borderRadius: 8,
        background: 'var(--bg-card)', border: '1px solid var(--border-subtle)',
        display: 'flex', alignItems: 'center', gap: 16,
      }}>
        <div style={{
          width: 12, height: 12, borderRadius: '50%',
          background: providers.primary_available ? 'var(--status-running)' : 'var(--status-error)',
        }} />
        <div>
          <div style={{ fontWeight: 600, color: 'var(--text-primary)' }}>
            {providers.primary_available ? 'Système opérationnel' : 'Système dégradé'}
          </div>
          <div style={{ fontSize: 11, color: 'var(--text-muted)' }}>
            {providerList.filter(([, p]) => p.online).length} provider(s) en ligne sur {providerList.length}
          </div>
        </div>
      </div>

      {/* Providers */}
      <div style={{
        background: 'var(--bg-card)', padding: 16, borderRadius: 8,
        border: '1px solid var(--border-subtle)', marginBottom: 16,
      }}>
        <h3 style={{ fontSize: 14, fontWeight: 600, marginBottom: 12, color: 'var(--text-primary)' }}>
          ☁️ Providers LLM
        </h3>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
          {providerList.map(([name, info]) => {
            const status = info.online ? 'online' : (info.status ?? 'offline');
            return (
              <div key={name} style={{
                display: 'flex', justifyContent: 'space-between',
                alignItems: 'center', padding: '10px 12px',
                background: 'var(--bg-secondary)', borderRadius: 6,
              }}>
                <div>
                  <div style={{ fontWeight: 500, color: 'var(--text-primary)' }}>
                    {name}
                  </div>
                  {info.error && (
                    <div style={{ fontSize: 11, color: 'var(--status-error)', marginTop: 2 }}>
                      {info.error}
                    </div>
                  )}
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
                  {typeof info.latency_ms === 'number' && info.latency_ms > 0 && (
                    <span style={{ fontSize: 11, color: 'var(--text-muted)', fontFamily: 'var(--font-mono)' }}>
                      {info.latency_ms}ms
                    </span>
                  )}
                  <span style={{ fontSize: 12, color: statusColor(status) }}>
                    ● {status}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Diagnostics */}
      {diagnostics && (
        <div style={{
          background: 'var(--bg-card)', padding: 16, borderRadius: 8,
          border: '1px solid var(--border-subtle)',
        }}>
          <h3 style={{ fontSize: 14, fontWeight: 600, marginBottom: 12, color: 'var(--text-primary)' }}>
            🔍 Diagnostics
          </h3>

          {diagnostics.audit_ledger?.status && (
            <div style={{
              display: 'flex', justifyContent: 'space-between',
              padding: '8px 12px', background: 'var(--bg-secondary)', borderRadius: 4,
              marginBottom: 8,
            }}>
              <span style={{ color: 'var(--text-secondary)' }}>Audit Ledger</span>
              <span style={{ fontSize: 12, color: statusColor(String(diagnostics.audit_ledger.status)) }}>
                ● {diagnostics.audit_ledger.status}
              </span>
            </div>
          )}

          <details style={{ marginTop: 8 }}>
            <summary style={{
              cursor: 'pointer', fontSize: 11,
              color: 'var(--text-muted)', fontFamily: 'var(--font-mono)',
            }}>
              Voir le JSON complet
            </summary>
            <pre style={{
              fontSize: 11, marginTop: 8, padding: 12,
              background: 'var(--bg-secondary)', borderRadius: 4,
              overflow: 'auto', maxHeight: 300, color: 'var(--text-secondary)',
            }}>
              {JSON.stringify(diagnostics, null, 2)}
            </pre>
          </details>
        </div>
      )}
    </div>
  );
}