{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-zzio",
  "version": "0.1.0",
  "identifier": "com.ezzio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E-zzio",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' http://localhost:* http://127.0.0.1:* http://100.*.*.*:* ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MEJENzRGNUI0NkQ3RTkKUldUcDEwWmJUOWNMR1pQWFpnMHhRMTY5UTlzVHk4aWh2a3lkRmpmYzBMdjBHMzg4NU9PWWM1eDkK",
      "endpoints": [
        "https://github.com/BidiNani/ezzio-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
