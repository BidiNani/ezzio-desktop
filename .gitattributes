# Normalisation des fins de ligne (Windows/Linux/macOS)
* text=auto eol=lf

# Code : LF strict
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Scripts shell
*.sh    text eol=lf

# Binaires : ne pas toucher
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.node  binary